# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
#   cd samples/configdirector-openfeature-server-provider/sinatra && cp .env.example .env
#
# `bundle exec puma` reads .env when it loads config.ru.
# A variable set in the environment wins over the same variable in .env.

# Your ConfigDirector server SDK key. A secret.
CONFIGDIRECTOR_SERVER_KEY=fake-sample-key

# Only needed when routing through a proxy to reach ConfigDirector.
# CONFIGDIRECTOR_BASE_URL=https://configdirector-proxy.example.com

# streaming (the default) or polling.
CONFIGDIRECTOR_MODE=streaming

# How long the first request in each process waits for config, in seconds.
CONFIGDIRECTOR_TIMEOUT=3

# The lowest level the sample writes, the SDK's lines included: debug, info, warn or error.
# Set debug to see more of what the SDK does.
CONFIGDIRECTOR_LOG_LEVEL=info
