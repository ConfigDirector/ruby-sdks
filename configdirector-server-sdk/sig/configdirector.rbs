module ConfigDirector
  VERSION: String

  type config_value = bool | String | Integer | Float | Hash[untyped, untyped] | Array[untyped]

  type seconds = Integer | Float

  interface _Logger
    def debug: (String message) -> void

    def info: (String message) -> void

    def warn: (String message) -> void

    def error: (String message) -> void
  end

  interface _LogLevelCheck
    def call: () -> untyped
  end

  def self.create_client: (
    ?String? server_sdk_key,
    ?metadata: Metadata?,
    ?connection: ConnectionOptions?,
    ?logger: (_Logger & Object)?,
    ?log_level: (Integer | Symbol | String)?,
    ?telemetry: TelemetryOptions?,
    ?hooks: ClientHooks?
  ) -> ConfigDirectorClient

  class ConfigDirectorError < StandardError
  end

  class ConfigDirectorValidationError < ConfigDirectorError
  end

  class ConfigDirectorInitializationError < ConfigDirectorError
  end

  class ConfigDirectorConnectionError < ConfigDirectorError
    attr_reader status: Integer?

    def initialize: (?String? message, ?status: Integer?) -> void
  end

  class Metadata
    include Internal::ComparedByValue

    attr_reader app_name: String?
    attr_reader app_version: String?

    def initialize: (?app_name: String?, ?app_version: String?) -> void
  end

  class ConnectionOptions
    include Internal::ComparedByValue

    attr_reader mode: String
    attr_reader polling_interval: seconds
    attr_reader timeout: seconds
    attr_reader url: String
    attr_reader file: (String | Pathname)?
    attr_reader values: Hash[String | Symbol, untyped]?

    def initialize: (
      ?mode: String,
      ?polling_interval: seconds,
      ?timeout: seconds,
      ?url: String,
      ?file: (String | Pathname)?,
      ?values: Hash[String | Symbol, untyped]?
    ) -> void
  end

  class TelemetryOptions
    include Internal::ComparedByValue

    attr_reader event_queue_limit: Integer
    attr_reader flush_interval: seconds

    def initialize: (?event_queue_limit: Integer, ?flush_interval: seconds) -> void
  end

  interface _EventHandler
    def call: (*untyped) -> untyped
  end

  type hook = _EventHandler | Array[_EventHandler]

  class ClientHooks
    include Internal::ComparedByValue

    attr_reader client_ready: hook?
    attr_reader configs_updated: hook?
    attr_reader config_evaluated: hook?
    attr_reader connection_error: hook?

    def initialize: (
      ?client_ready: hook?,
      ?configs_updated: hook?,
      ?config_evaluated: hook?,
      ?connection_error: hook?
    ) -> void
  end

  class ConfigsUpdatedEvent
    include Internal::ComparedByValue

    attr_reader keys: Array[String]
    attr_reader removed_keys: Array[String]

    def initialize: (keys: Array[String], removed_keys: Array[String]) -> void
  end

  class ConfigEvaluatedEvent
    include Internal::ComparedByValue

    attr_reader evaluation: ConfigEvaluation

    def initialize: (evaluation: ConfigEvaluation) -> void
  end

  class ConnectionErrorEvent
    include Internal::ComparedByValue

    attr_reader error: ConfigDirectorConnectionError

    def initialize: (error: ConfigDirectorConnectionError) -> void
  end

  class Subscription
    @removal: ^() -> nil
    @closed: bool

    def initialize: () { () -> nil } -> void

    def close: () -> nil

    def closed?: () -> bool
  end

  class Context
    include Internal::ComparedByValue

    attr_reader id: String?
    attr_reader kind: String?
    attr_reader name: String?
    attr_reader traits: Hash[String, untyped]?

    @anonymous: bool

    def initialize: (
      ?id: (String | Integer)?,
      ?kind: String?,
      ?name: String?,
      ?traits: Hash[untyped, untyped]?,
      ?anonymous: bool
    ) -> void

    def anonymous?: () -> bool
  end

  class Variation
    include Internal::ComparedByValue

    attr_reader id: String
    attr_reader name: String?

    def initialize: (id: String, ?name: String?) -> void
  end

  class ConfigState
    include Internal::ComparedByValue

    attr_reader id: String
    attr_reader key: String
    attr_reader type: String
    attr_reader value: String?
    attr_reader value_id: String?
    attr_reader variation: Variation?
    attr_reader rule_id: String?
    attr_reader share_id: String?

    def initialize: (
      id: String,
      key: String,
      type: String,
      value: String?,
      ?value_id: String?,
      ?variation: Variation?,
      ?rule_id: String?,
      ?share_id: String?
    ) -> void
  end

  class ConfigEvaluation
    include Internal::ComparedByValue

    attr_reader key: String
    attr_reader value: config_value
    attr_reader value_id: String?
    attr_reader variation: Variation?
    attr_reader reason: String
    attr_reader context: Context?

    @default_value: bool

    def initialize: (
      key: String,
      value: config_value,
      default_value: bool,
      reason: String,
      ?value_id: String?,
      ?variation: Variation?,
      ?context: Context?
    ) -> void

    def default_value?: () -> bool
  end

  class ConfigDirectorClient
    WHAT_FOLLOWS_AN_INIT_WITHOUT_VALUES_BY_MODE: Hash[String, String]

    @mode: String
    @timeout: Float
    @log: Internal::Logging::ClientLog
    @connection_lifecycle: Monitor
    @serving_state: Internal::Client::ServingState
    @event_handlers: Internal::Client::EventHandlers
    @watches: Internal::Client::Watches
    @config_reader: Internal::Client::ConfigReader
    @client_connection: Internal::Client::ClientConnection

    def initialize: (
      connection: Internal::Connection::_Connection,
      connection_options: ConnectionOptions,
      metadata: Metadata,
      logger: _Logger & Object,
      hooks: ClientHooks
    ) -> void

    def init: () -> void

    def ready?: () -> bool

    def get_value: (String config_key, config_value default_value, ?Context? context) -> config_value

    def evaluate: (String config_key, config_value default_value, ?Context? context) -> ConfigEvaluation

    def get_all_configs: (?context: Context?, ?config_keys: Array[String]?) -> Hash[String, ConfigState]

    def watch: (String config_key, config_value default_value, ?Context? context) { (config_value value) -> void } -> Subscription

    def unwatch: (String config_key, ?Proc? callback) -> nil

    def unwatch_all: () -> nil

    def on: (Symbol event_name, ?_EventHandler? handler) ?{ (*untyped) -> void } -> Subscription

    def off: (Symbol event_name, ?_EventHandler? handler) -> nil

    def close: () -> void

    def closed?: () -> bool

    private

    def raise_if_closed: () -> void

    def client_connection_over: (Internal::Connection::_Connection connection) -> Internal::Client::ClientConnection

    def warn_that_no_values_arrived_in_time: () -> void
  end
end
