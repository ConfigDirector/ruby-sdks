module ConfigDirector
  VERSION: String

  type config_value = bool | String | Integer | Float | Hash[untyped, untyped] | Array[untyped]

  type seconds = Integer | Float

  interface _Logger
    def debug: (String message) -> void

    def info: (String message) -> void

    def warn: (String message) -> void

    def error: (String message) -> void
  end

  interface _LogLevelCheck
    def call: () -> untyped
  end

  def self.create_client: (
    ?String? server_sdk_key,
    ?metadata: Metadata?,
    ?connection: ConnectionOptions?,
    ?logger: (_Logger & Object)?,
    ?log_level: (Integer | Symbol | String)?,
    ?telemetry: TelemetryOptions?,
    ?hooks: ClientHooks?
  ) -> ConfigDirectorClient

  class ConfigDirectorError < StandardError
  end

  class ConfigDirectorValidationError < ConfigDirectorError
  end

  class ConfigDirectorInitializationError < ConfigDirectorError
  end

  class ConfigDirectorConnectionError < ConfigDirectorError
    attr_reader status: Integer?

    def initialize: (?String? message, ?status: Integer?) -> void
  end

  class Metadata < Data
    attr_reader app_name: String?
    attr_reader app_version: String?

    def self.new: (?app_name: _ToS?, ?app_version: _ToS?) -> instance

    def initialize: (?app_name: _ToS?, ?app_version: _ToS?) -> void

    def with: (?app_name: _ToS?, ?app_version: _ToS?) -> instance

    def to_h: () -> { app_name: String?, app_version: String? }
  end

  class ConnectionOptions < Data
    attr_reader mode: String
    attr_reader polling_interval: seconds
    attr_reader timeout: seconds
    attr_reader url: String
    attr_reader file: (String | Pathname)?
    attr_reader values: Hash[String | Symbol, untyped]?

    def self.new: (
      ?mode: String,
      ?polling_interval: seconds,
      ?timeout: seconds,
      ?url: String,
      ?file: (String | Pathname)?,
      ?values: Hash[String | Symbol, untyped]?
    ) -> instance

    def initialize: (
      ?mode: String,
      ?polling_interval: seconds,
      ?timeout: seconds,
      ?url: String,
      ?file: (String | Pathname)?,
      ?values: Hash[String | Symbol, untyped]?
    ) -> void

    def with: (
      ?mode: String,
      ?polling_interval: seconds,
      ?timeout: seconds,
      ?url: String,
      ?file: (String | Pathname)?,
      ?values: Hash[String | Symbol, untyped]?
    ) -> instance

    def to_h: () -> {
      mode: String,
      polling_interval: seconds,
      timeout: seconds,
      url: String,
      file: (String | Pathname)?,
      values: Hash[String | Symbol, untyped]?
    }
  end

  class TelemetryOptions < Data
    attr_reader event_queue_limit: Integer
    attr_reader flush_interval: seconds

    def self.new: (?event_queue_limit: Integer, ?flush_interval: seconds) -> instance

    def initialize: (?event_queue_limit: Integer, ?flush_interval: seconds) -> void

    def with: (?event_queue_limit: Integer, ?flush_interval: seconds) -> instance

    def to_h: () -> { event_queue_limit: Integer, flush_interval: seconds }
  end

  interface _EventHandler
    def call: (*untyped) -> untyped
  end

  type hook = _EventHandler | Array[_EventHandler]

  class ClientHooks < Data
    attr_reader client_ready: hook?
    attr_reader configs_updated: hook?
    attr_reader config_evaluated: hook?
    attr_reader connection_error: hook?

    def self.new: (
      ?client_ready: hook?,
      ?configs_updated: hook?,
      ?config_evaluated: hook?,
      ?connection_error: hook?
    ) -> instance

    def initialize: (
      ?client_ready: hook?,
      ?configs_updated: hook?,
      ?config_evaluated: hook?,
      ?connection_error: hook?
    ) -> void

    def with: (
      ?client_ready: hook?,
      ?configs_updated: hook?,
      ?config_evaluated: hook?,
      ?connection_error: hook?
    ) -> instance

    def to_h: () -> {
      client_ready: hook?,
      configs_updated: hook?,
      config_evaluated: hook?,
      connection_error: hook?
    }
  end

  class ConfigsUpdatedEvent < Data
    attr_reader keys: Array[String]
    attr_reader removed_keys: Array[String]

    def self.new: (keys: Array[String], removed_keys: Array[String]) -> instance

    def initialize: (keys: Array[String], removed_keys: Array[String]) -> void

    def with: (?keys: Array[String], ?removed_keys: Array[String]) -> instance

    def to_h: () -> { keys: Array[String], removed_keys: Array[String] }
  end

  class ConfigEvaluatedEvent < Data
    attr_reader evaluation: ConfigEvaluation[config_value]

    def self.new: (evaluation: ConfigEvaluation[config_value]) -> instance

    def with: (?evaluation: ConfigEvaluation[config_value]) -> instance

    def to_h: () -> { evaluation: ConfigEvaluation[config_value] }
  end

  class ConnectionErrorEvent < Data
    attr_reader error: ConfigDirectorConnectionError

    def self.new: (error: ConfigDirectorConnectionError) -> instance

    def with: (?error: ConfigDirectorConnectionError) -> instance

    def to_h: () -> { error: ConfigDirectorConnectionError }
  end

  class Subscription
    @removal: ^() -> nil
    @closed: bool

    def initialize: () { () -> nil } -> void

    def close: () -> nil

    def closed?: () -> bool
  end

  class Context < Data
    attr_reader id: String?
    attr_reader kind: String?
    attr_reader name: String?
    attr_reader traits: Hash[String, untyped]?

    def self.new: (
      ?id: (String | Integer)?,
      ?kind: String?,
      ?name: String?,
      ?traits: Hash[untyped, untyped]?,
      ?anonymous: bool
    ) -> instance

    def initialize: (
      ?id: (String | Integer)?,
      ?kind: String?,
      ?name: String?,
      ?traits: Hash[untyped, untyped]?,
      ?anonymous: bool
    ) -> void

    def with: (
      ?id: (String | Integer)?,
      ?kind: String?,
      ?name: String?,
      ?traits: Hash[untyped, untyped]?,
      ?anonymous: bool
    ) -> instance

    def to_h: () -> {
      id: String?,
      kind: String?,
      name: String?,
      traits: Hash[String, untyped]?,
      anonymous: bool
    }

    def anonymous?: () -> bool

    private

    attr_reader anonymous: bool
  end

  class Variation < Data
    attr_reader id: String
    attr_reader name: String?

    def self.new: (id: String, ?name: String?) -> instance

    def initialize: (id: String, ?name: String?) -> void

    def with: (?id: String, ?name: String?) -> instance

    def to_h: () -> { id: String, name: String? }
  end

  class ConfigState < Data
    attr_reader id: String
    attr_reader key: String
    attr_reader type: String
    attr_reader value: String?
    attr_reader value_id: String?
    attr_reader variation: Variation?
    attr_reader rule_id: String?
    attr_reader share_id: String?

    def self.new: (
      id: String,
      key: String,
      type: String,
      value: String?,
      ?value_id: String?,
      ?variation: Variation?,
      ?rule_id: String?,
      ?share_id: String?
    ) -> instance

    def initialize: (
      id: String,
      key: String,
      type: String,
      value: String?,
      ?value_id: String?,
      ?variation: Variation?,
      ?rule_id: String?,
      ?share_id: String?
    ) -> void

    def with: (
      ?id: String,
      ?key: String,
      ?type: String,
      ?value: String?,
      ?value_id: String?,
      ?variation: Variation?,
      ?rule_id: String?,
      ?share_id: String?
    ) -> instance

    def to_h: () -> {
      id: String,
      key: String,
      type: String,
      value: String?,
      value_id: String?,
      variation: Variation?,
      rule_id: String?,
      share_id: String?
    }
  end

  class ConfigEvaluation[out V < config_value] < Data
    attr_reader key: String
    attr_reader value: V
    attr_reader reason: String
    attr_reader value_id: String?
    attr_reader variation: Variation?
    attr_reader context: Context?

    def self.new: [V < config_value] (
      key: String,
      value: V,
      default_value: bool,
      reason: String,
      ?value_id: String?,
      ?variation: Variation?,
      ?context: Context?
    ) -> ConfigEvaluation[V]

    def initialize: (
      key: String,
      value: V,
      default_value: bool,
      reason: String,
      ?value_id: String?,
      ?variation: Variation?,
      ?context: Context?
    ) -> void

    def with: (
      ?key: String,
      ?default_value: bool,
      ?reason: String,
      ?value_id: String?,
      ?variation: Variation?,
      ?context: Context?
    ) -> ConfigEvaluation[V]
            | [W < config_value] (
      value: W,
      ?key: String,
      ?default_value: bool,
      ?reason: String,
      ?value_id: String?,
      ?variation: Variation?,
      ?context: Context?
    ) -> ConfigEvaluation[W]

    def to_h: () -> {
      key: String,
      value: V,
      default_value: bool,
      reason: String,
      value_id: String?,
      variation: Variation?,
      context: Context?
    }

    def default_value?: () -> bool

    private

    attr_reader default_value: bool
  end

  class ConfigDirectorClient
    @mode: String
    @timeout: Float
    @log: Internal::Logging::ClientLog
    @connection_lifecycle: Monitor
    @serving_state: Internal::Client::ServingState
    @event_handlers: Internal::Client::EventHandlers
    @watches: Internal::Client::Watches
    @config_reader: Internal::Client::ConfigReader
    @event_tracking: Internal::Client::EventTracking
    @client_connection: Internal::Client::ClientConnection

    def initialize: (
      connection: Internal::Connection::_Connection,
      telemetry: Internal::Telemetry::_ClientTelemetry,
      mode: String,
      timeout: seconds,
      metadata: Metadata,
      logger: _Logger & Object,
      hooks: ClientHooks
    ) -> void

    def init: () -> void

    def ready?: () -> bool

    def get_value: (String config_key, bool default_value, ?Context? context) -> bool
                 | (String config_key, String default_value, ?Context? context) -> String
                 | (String config_key, Integer default_value, ?Context? context) -> Integer
                 | (String config_key, Float default_value, ?Context? context) -> Float
                 | (String config_key, Hash[String, untyped] default_value, ?Context? context) -> Hash[String, untyped]
                 | [K] (String config_key, Hash[K, untyped] default_value, ?Context? context) -> Hash[K | String, untyped]
                 | (String config_key, Array[untyped] default_value, ?Context? context) -> Array[untyped]

    def evaluate: (String config_key, bool default_value, ?Context? context) -> ConfigEvaluation[bool]
                | (String config_key, String default_value, ?Context? context) -> ConfigEvaluation[String]
                | (String config_key, Integer default_value, ?Context? context) -> ConfigEvaluation[Integer]
                | (String config_key, Float default_value, ?Context? context) -> ConfigEvaluation[Float]
                | (String config_key, Hash[String, untyped] default_value, ?Context? context) -> ConfigEvaluation[Hash[String, untyped]]
                | [K] (String config_key, Hash[K, untyped] default_value, ?Context? context) -> ConfigEvaluation[Hash[K | String, untyped]]
                | (String config_key, Array[untyped] default_value, ?Context? context) -> ConfigEvaluation[Array[untyped]]

    def get_all_configs: (?context: Context?, ?config_keys: Array[String]?) -> Hash[String, ConfigState]

    def watch: (String config_key, bool default_value, ?Context? context) { (bool value) -> void } -> Subscription
             | (String config_key, String default_value, ?Context? context) { (String value) -> void } -> Subscription
             | (String config_key, Integer default_value, ?Context? context) { (Integer value) -> void } -> Subscription
             | (String config_key, Float default_value, ?Context? context) { (Float value) -> void } -> Subscription
             | (String config_key, Hash[String, untyped] default_value, ?Context? context) { (Hash[String, untyped] value) -> void } -> Subscription
             | [K] (String config_key, Hash[K, untyped] default_value, ?Context? context) { (Hash[K | String, untyped] value) -> void } -> Subscription
             | (String config_key, Array[untyped] default_value, ?Context? context) { (Array[untyped] value) -> void } -> Subscription

    def unwatch: (String config_key, ?Proc? callback) -> nil

    def unwatch_all: () -> nil

    def track: (
      String | Symbol event_name,
      ?Context? context,
      ?value: (Integer | Float)?,
      ?details: Hash[String | Symbol, untyped]?
    ) -> nil

    def on: (Symbol event_name, ?_EventHandler? handler) ?{ (*untyped) -> void } -> Subscription

    def off: (Symbol event_name, ?_EventHandler? handler) -> nil

    def close: () -> void

    def closed?: () -> bool

    def inspect: () -> String

    private

    def raise_if_closed: () -> void

    def warn_unless_the_first_values_arrive_by: (Float give_up_at) -> void

    def config_reader_over: (Internal::Telemetry::_ClientTelemetry telemetry) -> Internal::Client::ConfigReader

    def client_connection_over: (
      Internal::Connection::_Connection connection,
      Internal::Telemetry::_ClientTelemetry telemetry
    ) -> Internal::Client::ClientConnection
  end
end
