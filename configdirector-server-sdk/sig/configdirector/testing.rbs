module ConfigDirector
  module Testing
    def self.create_test_client: (
      ?Hash[String | Symbol, untyped]? values,
      ?timeout: seconds?,
      ?logger: (_Logger & Object)?
    ) -> TestClient

    class TestClient
      @connection: Internal::Connection::InMemoryConnection

      attr_reader client: ConfigDirectorClient

      attr_reader tracked_events: Array[TrackedEvent]

      def initialize: (
        ConfigDirectorClient client,
        Internal::Connection::InMemoryConnection connection,
        Array[TrackedEvent] tracked_events
      ) -> void

      def set_value: (String | Symbol config_key, untyped value) -> nil

      def remove_value: (String | Symbol config_key) -> nil

      def replace_values: (Hash[String | Symbol, untyped] values) -> nil

      def hold_initialization: () -> nil

      def complete_initialization: () -> nil

      def fail_initialization: () -> nil
    end

    class TrackedEvent
      include Internal::ComparedByValue

      attr_reader name: String
      attr_reader context: Context?
      attr_reader value: (Integer | Float)?
      attr_reader details: Hash[String, untyped]?

      def initialize: (
        name: String,
        ?context: Context?,
        ?value: (Integer | Float)?,
        ?details: Hash[String, untyped]?
      ) -> void
    end
  end
end
