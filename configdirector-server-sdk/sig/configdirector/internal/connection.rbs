module ConfigDirector
  module Internal
    module Connection
      interface _Connection
        def open: (
          report_unrecoverable_error: ^(ConfigDirectorConnectionError unrecoverable_error) -> void
        ) { (ServerSdkPayload payload) -> void } -> Symbol

        def restart_in_a_forked_process: (
          report_unrecoverable_error: ^(ConfigDirectorConnectionError unrecoverable_error) -> void
        ) { (ServerSdkPayload payload) -> void } -> void

        def close: () -> void
      end

      interface _ConnectionOfAMode
        def for_a_client_with: (
          server_sdk_key: String,
          metadata: Metadata,
          connection_options: ConnectionOptions,
          sdk_identity: Identity::SdkIdentity,
          logger: _Logger & Object
        ) -> _Connection
      end

      class NotAServerSdkPayload < ConfigDirectorError
      end

      class UnreadableDefinition < ConfigDirectorError
      end

      class ServerSdkPayload < Data
        attr_reader delta: bool

        alias delta? delta
        attr_reader configs: Hash[String, ConfigDefinition]
        attr_reader segments: Evaluation::segments
        attr_reader unreadable_configs: Hash[String, String]
        attr_reader unreadable_segments: Hash[String, String]

        def self.new: (
          delta: bool,
          configs: Hash[String, ConfigDefinition],
          segments: Evaluation::segments,
          unreadable_configs: Hash[String, String],
          unreadable_segments: Hash[String, String]
        ) -> instance

        def self.without_definitions: () -> ServerSdkPayload

        def self.of_definitions: (Hash[String, ConfigDefinition] configs) -> ServerSdkPayload

        def self.delta_of_definitions: (Hash[String, ConfigDefinition] configs) -> ServerSdkPayload

        def configs_held_after: (Hash[String, ConfigDefinition] held_configs) -> Hash[String, ConfigDefinition]

        def segments_held_after: (Evaluation::segments held_segments) -> Evaluation::segments

        def segment_ids: () -> Array[String]
      end

      class ConfigDefinition < Data
        attr_reader id: String
        attr_reader key: String
        attr_reader type: String
        attr_reader targeting_rules: Evaluation::TargetingRules
        attr_reader variations: Array[Variation]

        def self.new: (
          id: String,
          key: String,
          type: String,
          targeting_rules: Evaluation::TargetingRules,
          variations: Array[Variation]
        ) -> instance

        def self.serving_each_value_to_every_context: (
          Hash[untyped, untyped] values,
          String id_prefix
        ) -> Hash[String, ConfigDefinition]

        def uses_any_segment_of?: (Array[String] segment_ids) -> bool

        def state_serving: (Evaluation::ServedValue served) -> ConfigState
      end

      module WireFields
        def self.object_or_nil_in: (untyped wire_object, String field) -> Hash[untyped, untyped]?

        def self.list_or_nil_in: (untyped wire_object, String field) -> Array[untyped]?

        def self.list_in: (Hash[untyped, untyped] wire_object, String field, String owner) -> Array[untyped]

        def self.objects_listed_in: (
          Hash[untyped, untyped] wire_object,
          String field,
          String owner,
          String listed
        ) -> Array[Hash[untyped, untyped]]

        def self.text_required_in: (Hash[untyped, untyped] wire_object, String field, String owner) -> String

        def self.text_or_nil_in: (Hash[untyped, untyped] wire_object, String field) -> String?

        def self.text_or_empty_in: (Hash[untyped, untyped] wire_object, String field) -> String

        def self.whole_number_or_nil_in: (Hash[untyped, untyped] wire_object, String field) -> Integer?
      end

      module ConditionParser
        ATTRIBUTE_KIND: String
        SEGMENT_KIND: String

        def self.condition_defined_by: (Hash[untyped, untyped] wire_condition) -> Evaluation::_Condition

        def self.condition_group_defined_by: (untyped wire_condition_group) -> Array[Evaluation::AttributeCondition]

        private def self.kind_named_in: (Hash[untyped, untyped] wire_condition) -> untyped

        private def self.attribute_condition_defined_by: (Hash[untyped, untyped] wire_condition) -> Evaluation::AttributeCondition

        private def self.target_value_text_of: (untyped wire_target_value) -> String

        private def self.segment_condition_defined_by: (Hash[untyped, untyped] wire_condition) -> Evaluation::SegmentCondition
      end

      module TargetingRulesParser
        def self.targeting_rules_defined_by: (Hash[untyped, untyped] wire_target) -> Evaluation::TargetingRules

        private def self.rule_defined_by: (Hash[untyped, untyped] wire_rule) -> Evaluation::Rule

        private def self.conditions_listed_in: (Hash[untyped, untyped] wire_rule, String rule_id) -> Array[Evaluation::_Condition]

        private def self.shares_listed_in: (Hash[untyped, untyped] wire_rule, String rule_id) -> Array[Evaluation::Share]?

        private def self.share_defined_by: (untyped wire_share) -> Evaluation::Share

        private def self.finite_percentage_of: (untyped wire_share) -> Float
      end

      module ServerSdkPayloadParser
        DELTA_KIND: String

        def self.payload_in: (String payload_text) -> ServerSdkPayload

        private def self.payload_defined_by: (
          untyped wire_kind,
          Hash[untyped, untyped] wire_configs,
          Hash[untyped, untyped] wire_segments
        ) -> ServerSdkPayload

        private def self.definitions_read_in: [Definition] (
          Hash[untyped, untyped] wire_definitions
        ) { (untyped wire_definition) -> Definition } -> [Hash[String, Definition], Hash[String, String]]

        private def self.config_defined_by: (untyped wire_config) -> ConfigDefinition

        private def self.variations_listed_in: (Hash[untyped, untyped] wire_config) -> Array[Variation]

        private def self.segment_defined_by: (untyped wire_segment) -> Evaluation::Segment
      end

      module OfflineValuesFile
        def self.values_in: (String | Pathname path) -> Hash[String, untyped]

        private def self.text_of: (String | Pathname path) -> String

        private def self.document_in: (String text, String | Pathname path) -> untyped

        private def self.description_of: (untyped document) -> String
      end

      class OfflineModeConnection
        CONFIG_ID_PREFIX: String

        @payload_of_the_offline_values: ^() -> ServerSdkPayload
        @delivering_the_offline_values: bool

        def self.for_a_client_with: (connection_options: ConnectionOptions, **untyped) -> OfflineModeConnection

        private def self.offline_source_given_by: (untyped file, untyped values) -> (:no_values | :values | :file | :file_and_values)

        private def self.serving_the_payload: (ServerSdkPayload payload) -> OfflineModeConnection

        private def self.reading_the_file: (untyped file) -> OfflineModeConnection

        private def self.payload_serving_the_given_values: (untyped values) -> ServerSdkPayload

        private def self.payload_serving_the_values_in_the_file: (String | Pathname file) -> ServerSdkPayload

        private def self.payload_serving: (Hash[untyped, untyped] values) -> ServerSdkPayload

        private def self.new: () { () -> ServerSdkPayload } -> instance

        def initialize: () { () -> ServerSdkPayload } -> void

        def open: (**untyped) { (ServerSdkPayload payload) -> void } -> Symbol

        def restart_in_a_forked_process: (**untyped) { (ServerSdkPayload payload) -> void } -> void

        def close: () -> void

        private

        def deliver_the_offline_values: () { (ServerSdkPayload payload) -> void } -> void
      end

      type test_client_connection_state = :not_connected | :holding_an_initialization | :connected

      type next_initialization = :serves_the_values | :fails | :is_held

      class TestClientValues < Data
        CONFIG_ID_PREFIX: String

        attr_reader configs: Hash[String, ConfigDefinition]

        def self.new: (configs: Hash[String, ConfigDefinition]) -> instance

        def self.serving: (untyped values) -> TestClientValues

        def self.rejecting_what_cannot_be_served: [T] () { () -> T } -> T

        def with: (configs: Hash[String, ConfigDefinition]) -> TestClientValues

        def merged_with: (TestClientValues values) -> TestClientValues

        def without_the_value_of: (untyped given_key) -> TestClientValues

        def full_payload: () -> ServerSdkPayload

        def delta_payload: () -> ServerSdkPayload
      end

      type outcome_of_a_held_initialization = :awaited | :completed | :failed

      class TestClientInitializations
        @lock: Thread::Mutex
        @timeout_seconds: seconds
        @settled: Thread::ConditionVariable
        @state: test_client_connection_state
        @next_initialization: next_initialization
        @held_until_monotonic_seconds: Float
        @outcome_of_the_held_initialization: outcome_of_a_held_initialization

        def initialize: (Thread::Mutex lock, seconds timeout_seconds) -> void

        def connected?: () -> bool

        def hold_the_next_initialization: () -> nil

        def serve_the_values_at_the_next_initialization: () -> void

        def begin_the_next_initialization: () -> next_initialization

        def complete_initialization: () -> (:held_initialization_completed | :no_initialization_held)

        def fail_initialization: () -> (:held_initialization_failed | :next_initialization_fails)

        def settling_the_held_initialization: [T] (:completed | :failed outcome) { () -> T } -> T

        def outcome_of_the_held_initialization: () -> (:completed | :failed | :ended_at_the_timeout)

        private

        def hold: () -> void

        def outcome_at_the_timeout: () -> (:completed | :failed | :ended_at_the_timeout)

        def cancel_a_hold_of_the_next_initialization: () -> void
      end

      class InMemoryConnection
        REFUSAL_MESSAGE: String

        @values: TestClientValues
        @log: Logging::ClientLog
        @lock: Thread::Mutex
        @initializations: TestClientInitializations
        @payloads_delivered_in_turn: PayloadsDeliveredInTurn
        @deliver_payload: ^(ServerSdkPayload payload) -> void
        @report_unrecoverable_error: ^(ConfigDirectorConnectionError unrecoverable_error) -> void

        def initialize: (untyped values, timeout_seconds: seconds, logger: _Logger & Object) -> void

        def set_value: (untyped config_key, untyped value) -> nil

        def remove_value: (untyped given_key) -> nil

        def replace_values: (untyped values) -> nil

        def hold_initialization: () -> nil

        def complete_initialization: () -> nil

        def fail_initialization: () -> nil

        def open: (
          report_unrecoverable_error: ^(ConfigDirectorConnectionError unrecoverable_error) -> void
        ) { (ServerSdkPayload payload) -> void } -> Symbol

        def restart_in_a_forked_process: (**untyped) { (ServerSdkPayload payload) -> void } -> void

        def close: () -> void

        private

        def begin_the_next_initialization: () -> next_initialization

        def deliver_the_stored_values: () -> :values_awaited

        def refuse_the_initialization: () -> :first_attempt_failed

        def what_follows_the_held_initialization: () -> Symbol

        def deliver_the_values_to_the_held_initialization: () -> nil

        def report_the_refusal: () -> void

        def add_if_connected: (ServerSdkPayload payload) -> void

        def deliver_the_waiting_payloads: () -> nil
      end

      class PayloadsDeliveredInTurn
        @lock: Thread::Mutex
        @waiting_payloads: Array[ServerSdkPayload]
        @delivering: bool

        def initialize: () -> void

        def add: (ServerSdkPayload payload) -> nil

        def deliver_each: () { (ServerSdkPayload payload) -> void } -> nil

        private

        def delivery_of_the_waiting_payloads: () -> (:left_to_another_call | :taken_by_this_call)

        def deliver_every_waiting_payload: () { (ServerSdkPayload payload) -> void } -> void
      end

      class PollingInterval < Data
        MINIMUM_SECONDS: Integer

        attr_reader configured_seconds: seconds

        def self.new: (configured_seconds: seconds) -> instance

        def raised_to_the_minimum?: () -> bool

        def seconds: () -> seconds
      end

      module JsonPostRequest
        def self.to: (URI::Generic uri, Identity::SdkIdentity sdk_identity, Hash[Symbol, untyped] body) -> Net::HTTP::Post

        def self.carrying: (String json_text, URI::Generic uri, Identity::SdkIdentity sdk_identity) -> Net::HTTP::Post
      end

      class RequestDeadline
        SECONDS_THE_TIMER_OF_THE_SESSION_STAYS_BEHIND: Integer

        @monotonic_seconds: ^() -> Float
        @passes_at: Float
        @seconds_the_request_may_take: seconds

        def self.on_the_clock_of_the_process: (seconds seconds_the_request_may_take) -> RequestDeadline

        def initialize: (seconds_the_request_may_take: seconds, monotonic_seconds: ^() -> Float) -> void

        def description_of_having_passed: () -> String

        def ending_the_exchange_when_it_passes: [T] (Net::HTTP http_session) { () -> T } -> T

        def seconds_left: () -> Float
      end

      module HttpSession
        def self.to: (URI::Generic uri) -> Net::HTTP
      end

      module RetryAfterHeader
        ASCII_DIGITS: Regexp

        def self.seconds_to_wait: (String? header_value, Time now) -> seconds?
      end
    end
  end
end
