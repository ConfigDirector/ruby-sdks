module ConfigDirector
  module Internal
    module Connection
      interface _Connection
        def open: (
          report_unrecoverable_error: ^(ConfigDirectorConnectionError unrecoverable_error) -> void
        ) { (ServerSdkPayload payload) -> void } -> Symbol

        def restart_in_a_forked_process: (
          report_unrecoverable_error: ^(ConfigDirectorConnectionError unrecoverable_error) -> void
        ) { (ServerSdkPayload payload) -> void } -> void

        def close: () -> void
      end

      interface _ConnectionOfAMode
        def for_a_client_with: (
          server_sdk_key: String,
          metadata: Metadata,
          connection_options: ConnectionOptions,
          sdk_identity: Identity::SdkIdentity,
          logger: _Logger & Object
        ) -> _Connection
      end

      class NotAServerSdkPayload < StandardError
      end

      class UnreadableDefinition < StandardError
      end

      class ServerSdkPayload < Data
        attr_reader delta: bool
        attr_reader configs: Hash[String, ConfigDefinition]
        attr_reader segments: Evaluation::segments
        attr_reader unreadable_configs: Hash[String, String]
        attr_reader unreadable_segments: Hash[String, String]

        def self.new: (
          delta: bool,
          configs: Hash[String, ConfigDefinition],
          segments: Evaluation::segments,
          unreadable_configs: Hash[String, String],
          unreadable_segments: Hash[String, String]
        ) -> instance

        def self.without_definitions: () -> ServerSdkPayload

        def self.of_definitions: (Hash[String, ConfigDefinition] configs) -> ServerSdkPayload

        def configs_held_after: (Hash[String, ConfigDefinition] held_configs) -> Hash[String, ConfigDefinition]

        def segments_held_after: (Evaluation::segments held_segments) -> Evaluation::segments

        def segment_ids: () -> Array[String]
      end

      class ConfigDefinition < Data
        attr_reader id: String
        attr_reader key: String
        attr_reader type: String
        attr_reader targeting_rules: Evaluation::TargetingRules
        attr_reader variations: Array[Variation]

        def self.new: (
          id: String,
          key: String,
          type: String,
          targeting_rules: Evaluation::TargetingRules,
          variations: Array[Variation]
        ) -> instance

        def self.serving_each_value_to_every_context: (
          Hash[untyped, untyped] values,
          String id_prefix
        ) -> Hash[String, ConfigDefinition]

        def uses_any_segment_of?: (Array[String] segment_ids) -> bool

        def state_serving: (Evaluation::ServedValue served) -> ConfigState
      end

      module WireFields
        def self.object_or_nil_in: (untyped wire_object, String field) -> Hash[untyped, untyped]?

        def self.list_or_nil_in: (untyped wire_object, String field) -> Array[untyped]?

        def self.list_in: (Hash[untyped, untyped] wire_object, String field, String owner) -> Array[untyped]

        def self.objects_listed_in: (
          Hash[untyped, untyped] wire_object,
          String field,
          String owner,
          String listed
        ) -> Array[Hash[untyped, untyped]]

        def self.text_required_in: (Hash[untyped, untyped] wire_object, String field, String owner) -> String

        def self.text_or_nil_in: (Hash[untyped, untyped] wire_object, String field) -> String?

        def self.text_or_empty_in: (Hash[untyped, untyped] wire_object, String field) -> String

        def self.whole_number_or_nil_in: (Hash[untyped, untyped] wire_object, String field) -> Integer?
      end

      module ConditionParser
        ATTRIBUTE_KIND: String
        SEGMENT_KIND: String

        def self.condition_defined_by: (Hash[untyped, untyped] wire_condition) -> Evaluation::_Condition

        def self.condition_group_defined_by: (untyped wire_condition_group) -> Array[Evaluation::AttributeCondition]

        def self.kind_of: (Hash[untyped, untyped] wire_condition) -> untyped

        def self.attribute_condition_defined_by: (Hash[untyped, untyped] wire_condition) -> Evaluation::AttributeCondition

        def self.target_value_text_of: (untyped wire_target_value) -> String

        def self.segment_condition_defined_by: (Hash[untyped, untyped] wire_condition) -> Evaluation::SegmentCondition
      end

      module TargetingRulesParser
        def self.targeting_rules_defined_by: (Hash[untyped, untyped] wire_target) -> Evaluation::TargetingRules

        def self.rule_defined_by: (Hash[untyped, untyped] wire_rule) -> Evaluation::Rule

        def self.conditions_listed_in: (Hash[untyped, untyped] wire_rule, String rule_id) -> Array[Evaluation::_Condition]

        def self.shares_listed_in: (Hash[untyped, untyped] wire_rule, String rule_id) -> Array[Evaluation::Share]?

        def self.share_defined_by: (untyped wire_share) -> Evaluation::Share
      end

      module ServerSdkPayloadParser
        DELTA_KIND: String

        def self.payload_in: (String payload_text) -> ServerSdkPayload

        def self.payload_defined_by: (
          untyped wire_kind,
          Hash[untyped, untyped] wire_configs,
          Hash[untyped, untyped] wire_segments
        ) -> ServerSdkPayload

        def self.definitions_read_in: [Definition] (
          Hash[untyped, untyped] wire_definitions
        ) { (untyped wire_definition) -> Definition } -> [Hash[String, Definition], Hash[String, String]]

        def self.config_defined_by: (untyped wire_config) -> ConfigDefinition

        def self.variations_listed_in: (Hash[untyped, untyped] wire_config) -> Array[Variation]

        def self.segment_defined_by: (untyped wire_segment) -> Evaluation::Segment
      end

      module OfflineValuesFile
        def self.values_in: (String | Pathname path) -> Hash[String, untyped]

        def self.text_of: (String | Pathname path) -> String

        def self.document_in: (String text, String | Pathname path) -> untyped

        def self.description_of: (untyped document) -> String
      end

      class OfflineModeConnection
        CONFIG_ID_PREFIX: String

        @payload_of_the_offline_values: ^() -> ServerSdkPayload
        @delivering_the_offline_values: bool

        def self.for_a_client_with: (connection_options: ConnectionOptions, **untyped) -> OfflineModeConnection

        def self.offline_source_given_by: (untyped file, untyped values) -> (:no_values | :values | :file | :file_and_values)

        def self.serving_the_payload: (ServerSdkPayload payload) -> OfflineModeConnection

        def self.reading_the_file: (untyped file) -> OfflineModeConnection

        def self.payload_serving_the_given_values: (untyped values) -> ServerSdkPayload

        def self.payload_serving_the_values_in_the_file: (String | Pathname file) -> ServerSdkPayload

        def self.payload_serving: (Hash[untyped, untyped] values) -> ServerSdkPayload

        def initialize: (^() -> ServerSdkPayload payload_of_the_offline_values) -> void

        def open: (**untyped) { (ServerSdkPayload payload) -> void } -> Symbol

        def restart_in_a_forked_process: (**untyped) { (ServerSdkPayload payload) -> void } -> void

        def close: () -> void

        private

        def deliver_the_offline_values: () { (ServerSdkPayload payload) -> void } -> void
      end

      class PollingInterval < Data
        MINIMUM_SECONDS: Integer

        attr_reader configured_seconds: seconds

        def self.new: (configured_seconds: seconds) -> instance

        def raised_to_the_minimum?: () -> bool

        def seconds: () -> seconds
      end

      module JsonPostRequest
        def self.to: (URI::Generic uri, Identity::SdkIdentity sdk_identity, **untyped body) -> Net::HTTP::Post
      end

      module HttpSession
        def self.to: (URI::Generic uri) -> Net::HTTP
      end

      module RetryAfterHeader
        ASCII_DIGITS: Regexp

        def self.seconds_to_wait: (String? header_value, Time now) -> seconds?
      end
    end
  end
end
