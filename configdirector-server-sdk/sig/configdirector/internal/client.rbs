module ConfigDirector
  module Internal
    module ComparedByValue : Object
      def ==: (untyped other) -> bool

      def eql?: (untyped other) -> bool

      def hash: () -> Integer

      def attribute_values: () -> Array[untyped]
    end

    module UnchangeableCopy
      def self.of: (untyped value) -> untyped
    end

    module Client
      module ClientOptionsValidation
        CONNECTION_MODES: Array[String]
        OFFLINE_MODE: String
        EVENT_QUEUE_LIMITS: Range[Integer]
        LOGGER_METHODS: Array[Symbol]

        def self.reject_unusable: (
          server_sdk_key: untyped,
          metadata: untyped,
          connection: untyped,
          telemetry: untyped,
          hooks: untyped,
          logger: untyped
        ) -> void

        def self.reject_an_option_of_another_class: (String option_name, untyped option, Class option_class) -> void

        def self.reject_an_unusable_logger: (untyped logger) -> void

        def self.reject_an_unusable_connection: (ConnectionOptions connection) -> void

        def self.reject_unusable_durations: (ConnectionOptions connection) -> void

        def self.reject_an_unusable_server_sdk_key_or_url: (untyped server_sdk_key, untyped url) -> void

        def self.reject_unusable_telemetry: (TelemetryOptions telemetry) -> void

        def self.finite_number?: (untyped value) -> bool

        def self.positive_finite_number?: (untyped value) -> bool

        def self.http_url?: (untyped url) -> bool
      end

      module ContextAttributes
        def self.identifier_text: (untyped id) -> String?

        def self.name_text: (untyped name) -> String?

        def self.traits_with_symbols_as_text: (untyped traits) -> Hash[String, untyped]?

        def self.anonymous_flag: (untyped anonymous) -> bool

        def self.with_symbols_as_text: (untyped trait) -> untyped

        def self.text_of_a_symbol: (untyped key_or_value) -> untyped
      end

      module ContextKind
        VALID_KIND: Regexp
        SAMPLE_MAXIMUM_CHARACTERS: Integer

        def self.valid?: (untyped kind) -> bool

        def self.sample_of: (untyped kind) -> String
      end

      type invalid_context_kind_recording = :new_kind_sample
                                          | :known_kind_sample
                                          | :first_beyond_sample_limit
                                          | :beyond_sample_limit

      class InvalidContextKinds
        DISTINCT_KIND_SAMPLE_LIMIT: Integer

        @mutex: Thread::Mutex
        @kind_samples: Set[String]
        @a_kind_was_beyond_the_sample_limit: bool

        def initialize: () -> void

        def record: (String kind_sample) -> invalid_context_kind_recording

        private

        def record_new: (String kind_sample) -> :new_kind_sample

        def record_first_beyond_the_sample_limit: () -> :first_beyond_sample_limit
      end

      class ContextAdmission
        LOG_AN_INVALID_KIND: Hash[Symbol, ^(Logging::ClientLog log, String kind_sample) -> void]

        @log: Logging::ClientLog
        @invalid_context_kinds: InvalidContextKinds

        def initialize: (Logging::ClientLog log) -> void

        def admitted_context_or_none: (untyped context) -> Context?
      end

      class ConfigRead < Data
        attr_reader config_key: String
        attr_reader in_code_default_value: Value::InCodeDefaultValue
        attr_reader context: Context?

        def self.new: (
          config_key: String,
          in_code_default_value: Value::InCodeDefaultValue,
          context: Context?
        ) -> instance

        def in_code_default_evaluation: (String reason) -> ConfigEvaluation

        def served_evaluation: (Value::TypedValue typed_value, ConfigState state, String reason) -> ConfigEvaluation
      end

      type arrival_of_values = :after_close | :first_values | :newer_values

      class ConfigReader
        @serving_state: ServingState
        @event_handlers: EventHandlers
        @log: Logging::ClientLog
        @context_admission: ContextAdmission

        def initialize: (ServingState serving_state, EventHandlers event_handlers, Logging::ClientLog log) -> void

        def config_read_of: (untyped config_key, untyped default_value, untyped context) -> ConfigRead

        def read: (ConfigRead config_read) -> ConfigEvaluation

        def states: (untyped context, untyped config_keys) -> Hash[String, ConfigState]

        private

        def reject_config_keys_that_are_not_an_array: (untyped config_keys) -> void
      end

      class Registrations[T < Object]
        @lock: Thread::Mutex
        @registrations_by_topic: Hash[untyped, Array[T]]

        def initialize: () -> void

        def add: (untyped topic, T registration) -> Subscription

        def remove_first: (untyped topic) { (T registration) -> boolish } -> nil

        def remove_all_on: (untyped topic) -> nil

        def remove_all: () -> nil

        def on: (Array[untyped] topics) -> Array[T]
      end

      class EventHandlers
        class HandlerRegistration < Data
          attr_reader handler: _EventHandler & Object

          def self.new: (handler: _EventHandler & Object) -> instance
        end

        HOOKS_BY_EVENT_NAME: Hash[Symbol, ^(ClientHooks hooks) -> untyped]

        @log: Logging::ClientLog
        @registrations: Registrations[HandlerRegistration]

        def self.one_handler_of: (untyped handler, Proc? block) -> untyped

        def initialize: (ClientHooks hooks, Logging::ClientLog log) -> void

        def add: (untyped event_name, _EventHandler & Object handler) -> Subscription

        def remove: (untyped event_name, untyped handler) -> nil

        def remove_all: () -> nil

        def deliver_client_ready: () -> void

        def deliver_configs_updated: (ConfigsUpdatedEvent update) -> void

        def deliver_config_evaluated: (ConfigEvaluation evaluation) -> void

        def deliver_connection_error: (ConfigDirectorConnectionError error) -> void

        private

        def reject_an_unknown_event_name: (untyped event_name) -> void

        def register: (Symbol event_name, _EventHandler & Object handler) -> Subscription

        def register_the_hooks_in: (ClientHooks hooks) -> void

        def register_a_hook: (Symbol event_name, untyped handler) -> void

        def handlers_given: (untyped hooks_of_the_event) -> Array[untyped]

        def deliver: (Symbol event_name, *untyped arguments) -> void
      end

      class Watches
        class Watch < Data
          attr_reader config_read: ConfigRead
          attr_reader callback: Proc

          def self.new: (config_read: ConfigRead, callback: Proc) -> instance

          def config_key: () -> String

          def receive: (config_value value) -> void
        end

        @log: Logging::ClientLog
        @registrations: Registrations[Watch]

        def initialize: (Logging::ClientLog log) -> void

        def add: (ConfigRead config_read, Proc callback) -> Subscription

        def remove: (untyped config_key, untyped callback) -> nil

        def remove_all: () -> nil

        def deliver_on: (Array[String] config_keys) { (ConfigRead config_read) -> config_value } -> void
      end

      module ClientFactory
        CONNECTION_CLASS_BY_MODE: Hash[String, Connection::_ConnectionOfAMode]

        def self.client_identified_as: (
          Identity::SdkIdentity sdk_identity,
          String? server_sdk_key,
          metadata: Metadata?,
          connection: ConnectionOptions?,
          logger: (_Logger & Object)?,
          log_level: (Integer | Symbol | String)?,
          telemetry: TelemetryOptions?,
          hooks: ClientHooks?
        ) -> ConfigDirectorClient

        def self.client_with_usable_options: (
          sdk_identity: Identity::SdkIdentity,
          server_sdk_key: String,
          metadata: Metadata,
          connection_options: ConnectionOptions,
          logger: _Logger & Object,
          hooks: ClientHooks
        ) -> ConfigDirectorClient

        def self.warn_of_a_polling_interval_below_the_minimum: (
          ConnectionOptions connection,
          _Logger & Object logger
        ) -> void
      end

      class ConnectionIntake
        @serving_state: ServingState
        @event_handlers: EventHandlers
        @watches: Watches
        @config_reader: ConfigReader
        @log: Logging::ClientLog

        def initialize: (
          serving_state: ServingState,
          event_handlers: EventHandlers,
          watches: Watches,
          config_reader: ConfigReader,
          log: Logging::ClientLog
        ) -> void

        def take_in: (Connection::ServerSdkPayload payload) -> void

        def take_in_unrecoverable_error: (ConfigDirectorConnectionError connection_error) -> void

        private

        def warn_of_the_definitions_skipped_in: (Connection::ServerSdkPayload payload) -> void

        def deliver_the_first_values: (ConfigsUpdatedEvent update) -> void

        def deliver_the_update: (ConfigsUpdatedEvent update) -> void
      end

      class ServingState
        @metadata: Metadata
        @lock: Thread::Mutex
        @first_values_no_longer_awaited: Thread::ConditionVariable
        @served_configs: ServedConfigs?
        @thread_delivering_the_first_values: Thread?
        @first_values_delivered: bool
        @closed: bool
        @connection_failed_unrecoverably: bool

        def initialize: (Metadata metadata) -> void

        def served_configs: () -> ServedConfigs?

        def closed?: () -> bool

        def serve: (Connection::ServerSdkPayload payload) -> [arrival_of_values, ConfigsUpdatedEvent]

        def end_the_delivery_of_the_first_values: () -> void

        def close: () -> void

        def expect_no_values_from_the_connection: () -> void

        def timed_out_waiting_for_the_first_values?: (Float give_up_at_monotonic_seconds) -> bool

        private

        def arrival_of_values: () -> arrival_of_values
      end

      class ServedConfigs < Data
        REASON_BY_SERVED_BY: Hash[Symbol, String]

        attr_reader configs: Hash[String, Connection::ConfigDefinition]
        attr_reader segments: Evaluation::segments
        attr_reader metadata: Metadata

        def self.new: (
          configs: Hash[String, Connection::ConfigDefinition],
          segments: Evaluation::segments,
          metadata: Metadata
        ) -> instance

        def self.without_definitions: (Metadata metadata) -> ServedConfigs

        def after: (Connection::ServerSdkPayload payload) -> ServedConfigs

        def update_since: (ServedConfigs replaced_configs, Connection::ServerSdkPayload payload) -> ConfigsUpdatedEvent

        def evaluation: (ConfigRead config_read) -> ConfigEvaluation

        def states: (Context? context, Array[String]? config_keys) -> Hash[String, ConfigState]

        private

        def keys_of_configs_using_any_segment_of: (Array[String] segment_ids) -> Array[String]

        def evaluation_of: (Connection::ConfigDefinition definition, ConfigRead config_read) -> ConfigEvaluation

        def value_served_to: (Context? context, Connection::ConfigDefinition definition) -> Evaluation::ServedValue

        def evaluation_context_of: (Context? context) -> Evaluation::EvaluationContext
      end
    end
  end
end
