module ConfigDirector
  module Internal
    module ComparedByValue : Object
      def ==: (untyped other) -> bool

      def eql?: (untyped other) -> bool

      def hash: () -> Integer

      def attribute_values: () -> Array[untyped]
    end

    module UnchangeableCopy
      def self.of: (untyped value) -> untyped
    end

    module Client
      module ClientOptionsValidation
        CONNECTION_MODES: Array[String]
        OFFLINE_MODE: String
        EVENT_QUEUE_LIMITS: Range[Integer]
        LOGGER_METHODS: Array[Symbol]

        def self.reject_unusable: (
          server_sdk_key: untyped,
          metadata: untyped,
          connection: untyped,
          telemetry: untyped,
          hooks: untyped,
          logger: untyped
        ) -> void

        def self.reject_an_option_of_another_class: (String option_name, untyped option, Class option_class) -> void

        def self.reject_an_unusable_logger: (untyped logger) -> void

        def self.reject_an_unusable_connection: (ConnectionOptions connection) -> void

        def self.reject_unusable_durations: (ConnectionOptions connection) -> void

        def self.reject_an_unusable_server_sdk_key_or_url: (untyped server_sdk_key, untyped url) -> void

        def self.reject_unusable_telemetry: (TelemetryOptions telemetry) -> void

        def self.finite_number?: (untyped value) -> bool

        def self.positive_finite_number?: (untyped value) -> bool

        def self.http_url?: (untyped url) -> bool
      end

      module ContextAttributes
        def self.identifier_text: (untyped id) -> String?

        def self.name_text: (untyped name) -> String?

        def self.traits_with_symbols_as_text: (untyped traits) -> Hash[String, untyped]?

        def self.anonymous_flag: (untyped anonymous) -> bool

        def self.with_symbols_as_text: (untyped trait) -> untyped

        def self.text_of_a_symbol: (untyped key_or_value) -> untyped
      end

      module ContextKind
        VALID_KIND: Regexp
        SAMPLE_MAXIMUM_CHARACTERS: Integer

        def self.valid?: (untyped kind) -> bool

        def self.sample_of: (untyped kind) -> String
      end

      type invalid_context_kind_recording = :new_kind_sample
                                          | :known_kind_sample
                                          | :first_beyond_sample_limit
                                          | :beyond_sample_limit

      class InvalidContextKinds
        DISTINCT_KIND_SAMPLE_LIMIT: Integer

        @mutex: Thread::Mutex
        @kind_samples: Set[String]
        @a_kind_was_beyond_the_sample_limit: bool

        def initialize: () -> void

        def record: (String kind_sample) -> invalid_context_kind_recording

        private

        def record_new: (String kind_sample) -> :new_kind_sample

        def record_first_beyond_the_sample_limit: () -> :first_beyond_sample_limit
      end

      class ContextAdmission
        LOG_AN_INVALID_KIND: Hash[Symbol, ^(_Logger logger, String kind_sample) -> void]

        @logger: _Logger
        @invalid_context_kinds: InvalidContextKinds

        def initialize: (_Logger logger) -> void

        def admitted_context_or_none: (untyped context) -> Context?
      end

      class ConfigRead < Data
        attr_reader config_key: String
        attr_reader in_code_default_value: Value::InCodeDefaultValue
        attr_reader context: Context?

        def self.new: (
          config_key: String,
          in_code_default_value: Value::InCodeDefaultValue,
          context: Context?
        ) -> instance

        def in_code_default_evaluation: (String reason) -> ConfigEvaluation

        def served_evaluation: (Value::TypedValue typed_value, ConfigState state, String reason) -> ConfigEvaluation
      end

      type arrival_of_values = :after_close | :first_values | :newer_values

      class ServingState
        @lock: Thread::Mutex
        @values_arrived_or_client_closed: Thread::ConditionVariable
        @served_configs: ServedConfigs?
        @closed: bool

        def initialize: () -> void

        def served_configs: () -> ServedConfigs?

        def closed?: () -> bool

        def serve: (ServedConfigs served_configs) -> arrival_of_values

        def close: () -> void

        def timed_out_waiting_for_the_first_values?: (Float timeout_seconds) -> bool

        private

        def arrival_of_values: () -> arrival_of_values
      end

      class ServedConfigs < Data
        REASON_BY_SERVED_BY: Hash[Symbol, String]

        attr_reader payload: Connection::ServerSdkPayload
        attr_reader metadata: Metadata

        def self.new: (payload: Connection::ServerSdkPayload, metadata: Metadata) -> instance

        def evaluation: (ConfigRead config_read) -> ConfigEvaluation

        def states: (Context? context, Array[String]? config_keys) -> Hash[String, ConfigState]

        private

        def evaluation_of: (Connection::ConfigDefinition definition, ConfigRead config_read) -> ConfigEvaluation

        def value_served_to: (Context? context, Connection::ConfigDefinition definition) -> Evaluation::ServedValue

        def evaluation_context_of: (Context? context) -> Evaluation::EvaluationContext
      end
    end
  end
end
