module ConfigDirector
  module Internal
    module Value
      type in_code_default_value_kind = :boolean | :string | :integer | :float | :json_object | :json_array

      class InCodeDefaultValue < Data
        attr_reader value: config_value
        attr_reader kind: in_code_default_value_kind

        def self.new: (value: config_value, kind: in_code_default_value_kind) -> instance

        def self.from: (untyped default_value) -> InCodeDefaultValue

        private def self.kind_of: (untyped default_value) -> in_code_default_value_kind?
      end

      class UnservableValue < ConfigDirectorError
      end

      class EncodedNativeValue < Data
        attr_reader config_type: String
        attr_reader served_text: String

        def self.new: (config_type: String, served_text: String) -> instance

        def self.of: (untyped value, String config_key) -> EncodedNativeValue

        private def self.encoded_float: (Float value, String config_key) -> EncodedNativeValue

        private def self.utf8_text_of: (String value, String config_key) -> String

        private def self.unservable_because_of_the_class_of: (untyped value, String config_key) -> UnservableValue
      end

      module PlainDecimalText
        DIGITS_UP_TO_THE_LAST_NONZERO_ONE: Regexp

        def self.of: (Float finite_float) -> String

        private def self.parts_around_the_point: (String digits, Integer digits_before_the_point) -> [String, String]
      end

      module Utf8Text
        def self.of: (String text) -> String?
      end

      module HashKeys
        def self.name_of: (untyped given_key) -> String?

        def self.description_of_a_key_given_twice_in: (Array[untyped] given_keys, Array[String] key_texts) -> String?

        private def self.how_the_two_keys_differ: (untyped first_given, untyped second_given) -> String
      end

      module NativeValues
        def self.reject_values_of_another_class: (untyped values) -> void

        def self.config_keys_of: (Hash[untyped, untyped] values) -> Array[String]

        def self.name_of_a_config_key: (untyped given_key) -> String

        private def self.config_key_named_by: (untyped given_key) -> String
      end

      class JsonPosition < Data
        attr_reader config_key: String
        attr_reader path: String
        attr_reader nesting: Integer

        def self.new: (config_key: String, path: String, nesting: Integer) -> instance

        def self.at_the_top_of: (String config_key) -> JsonPosition

        def of_member: (String key_text) -> JsonPosition

        def of_element: (Integer index) -> JsonPosition

        def unservable_because: (String problem) -> UnservableValue
      end

      module JsonContents
        MAXIMUM_NESTING: Integer
        WHAT_JSON_CONTENTS_CAN_HOLD: String

        def self.json_text_of: (Hash[untyped, untyped] | Array[untyped] json_value, String config_key) -> String

        private def self.contents_at: (JsonPosition position, untyped contents) -> untyped

        private def self.utf8_text_at: (JsonPosition position, String text) -> String

        private def self.finite_float_at: (JsonPosition position, Float float) -> Float

        private def self.container_contents_at: (
          JsonPosition position,
          Hash[untyped, untyped] | Array[untyped] container
        ) -> (Hash[String, untyped] | Array[untyped])

        private def self.members_at: (JsonPosition position, Hash[untyped, untyped] json_object) -> Hash[String, untyped]

        private def self.key_text_at: (JsonPosition position, untyped given_key) -> String

        private def self.unservable_contents_at: (JsonPosition position, String problem) -> UnservableValue
      end

      class TypedValue < Data
        attr_reader value: config_value

        def self.new: (value: config_value) -> instance
      end

      module ServedText
        CONFIG_TYPES_NOT_READABLE_AS_A_STRING: Array[String]
        WHOLE_NUMBER_DIGITS: Regexp
        TYPED_BY_IN_CODE_DEFAULT_VALUE_KIND: Hash[Symbol, ^(String served_text, String config_type) -> (TypedValue | String)]

        def self.typed_as: (
          in_code_default_value_kind in_code_default_value_kind,
          String? served_text,
          String config_type
        ) -> (TypedValue | String)

        private def self.boolean_in: (String served_text) -> (TypedValue | String)

        private def self.string_of: (String served_text, String config_type) -> (TypedValue | String)

        private def self.whole_number_in: (String served_text) -> (TypedValue | String)

        private def self.finite_number_in: (String served_text) -> (TypedValue | String)

        private def self.json_in: (String served_text, Class json_class) -> (TypedValue | String)
      end
    end
  end
end
